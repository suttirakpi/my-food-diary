{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve", // แนะนำสำหรับ TS 6.0+ เพื่อความยืดหยุ่น
    "moduleResolution": "bundler", // ใช้แทน node10 เพื่อลดอาการ deprecated
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true, // รองรับการทำงานร่วมกับ ts-node-dev ได้ดีขึ้น
    "noEmit": true // เนื่องจากเราใช้ ts-node-dev ในการรันตรงๆ
  }
}
